# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
COLLECTION_NAME=documents
QA_CACHE_COLLECTION=qa_cache
# Client/server version check (server is 1.18.2 everywhere). false only silences a known-safe gap warning.
QDRANT_CHECK_COMPATIBILITY=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
# Seconds a found acronym stays cached (86400 = 24 hours).
REDIS_CACHE_TTL=86400
REDIS_MAX_CACHE_SIZE=1000
# Seconds a word that is "not an acronym" stays cached, so common words skip Postgres (3600 = 1 hour).
REDIS_NEGATIVE_CACHE_TTL=3600
# Seconds a word stays "not found" after a Postgres error; short, so acronyms work again soon after Postgres recovers.
REDIS_DB_ERROR_CACHE_TTL=30
# Seconds to wait while connecting to Redis; after that, lookups read Postgres instead.
REDIS_SOCKET_CONNECT_TIMEOUT=1
# Seconds to wait for each Redis reply once connected; after that, lookups read Postgres instead.
REDIS_SOCKET_TIMEOUT=1

# ── Internal API ──────────────────────────────────────────────────────────────
# Required: secret for the internal_access_token header on internal endpoints; use a random value per env.
INTERNAL_API_TOKEN=

# ── Embedding & LLM Models ────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
# AWS Bedrock LLM (summarisation / tagging) and the region its endpoint lives in
LLAMA_MODEL_ID=meta.llama3-70b-instruct-v1:0
AWS_REGION=us-east-1

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=3000
CHUNK_OVERLAP=500
MARKDOWN_CHUNK_SIZE=3500
MARKDOWN_CHUNK_OVERLAP=800
# PDF chunking (applied to extracted / OCR'd PDF text)
PDF_CHUNK_SIZE=3000
PDF_CHUNK_OVERLAP=500
# Smaller chunks for content scraped from a markdown_url (~20% overlap)
URL_EXTRACTION_CHUNK_SIZE=1500
URL_EXTRACTION_CHUNK_OVERLAP=300

# ── Ingestion / Upload ────────────────────────────────────────────────────────
# Max size (in MB) of a single uploaded document accepted for processing (1GB default)
MAX_FILE_SIZE_MB=1024
# source_id is the key every chunk is stored/deleted/filtered by, so new uploads must match
# these rules (delete/update still accept older ids). Patterns must match the whole value.
MAX_SOURCE_ID_LENGTH=255
SOURCE_ID_PATTERN='^[A-Za-z0-9_\-.:]+$'
# Priority format for uploads (P1, P2, ...); the value is upper-cased before matching
PRIORITY_PATTERN='^P\d+$'
# Rollback of a partially failed upload (deletes the chunks that request stored).
# In-request: tries, and the first wait between tries (doubles each time: 0.5s, 1s)
UPLOAD_ROLLBACK_MAX_ATTEMPTS=3
UPLOAD_ROLLBACK_RETRY_WAIT_SECONDS=0.5
# If those fail, a background task keeps retrying; waits double from FIRST up to MAX
# (2, 4, 8, 16, 32, 60, 60, 60, 60 ≈ 5 min)
UPLOAD_ROLLBACK_BACKGROUND_MAX_ATTEMPTS=9
UPLOAD_ROLLBACK_BACKGROUND_FIRST_WAIT_SECONDS=2
UPLOAD_ROLLBACK_BACKGROUND_MAX_WAIT_SECONDS=60
# Max size (in MB) of an acronym bulk-upload CSV (small tabular text, not a document)
ACRONYM_BULK_UPLOAD_MAX_SIZE_MB=5
# Rows saved per database statement during an acronym bulk upload (1 to 10000)
ACRONYM_BULK_UPLOAD_BATCH_SIZE=200

# ── Search ────────────────────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.40
VECTOR_SEARCH_LIMIT=1
DEFAULT_SEARCH_TOP_K=10
MAX_SEARCH_TOP_K=100

# ── Hybrid Search (Phase 1) ───────────────────────────────────────────────────
# Master switch — set to false to fall back to pure semantic search
HYBRID_SEARCH_ENABLED=true

# Title match score multipliers (capped at 1.0)
# Applied when the query text is found in the title (acronym queries too, plus the boosts below).
EXACT_TITLE_BOOST=2.5
PARTIAL_TITLE_BOOST=1.5

# Summary match score multipliers (capped at 1.0). Lower than the title boosts since
# summary carries less weight; applied when the query text is found in the summary field.
EXACT_SUMMARY_BOOST=1.4
PARTIAL_SUMMARY_BOOST=1.2

# Acronym queries only: the boosts above, for the query with the acronym written out
# ("PTM document" -> "Parent Teacher Meeting document"). Both can apply. 1.0 = off.
# Title equals "Parent Teacher Meeting document":
ACRONYM_EXPANSION_EXACT_TITLE_BOOST=1.7
# Title contains it ("Parent Teacher Meeting document in school"):
ACRONYM_EXPANSION_PARTIAL_TITLE_BOOST=1.3
# The same two matches in the summary (equals / contains):
ACRONYM_EXPANSION_EXACT_SUMMARY_BOOST=1.4
ACRONYM_EXPANSION_PARTIAL_SUMMARY_BOOST=1.2

# Metadata match boost (reserved for future use)
METADATA_MATCH_BOOST=1.2

# Documents matched by title/summary text but missed by semantic search are added to
# the results and scored here. Scoring one downloads 5 vectors, and a short query can
# match thousands of titles, so past this limit scoring is skipped (field_scores stay null).
INJECTED_DOC_SCORING_MAX=200

# Queries with fewer words than this threshold skip spaCy stop-word removal.
# Keeps short / abbreviation queries (e.g. "SMC", "RTE", "AI") intact.
SHORT_QUERY_THRESHOLD=3

# ── Sparse / BM25 Search (Phase 2) ───────────────────────────────────────────
# Requires qdrant-client[fastembed]>=1.9.0 and a collection re-index.
# Keep false until the migration script (scripts/migrate_to_sparse_vectors.py)
# has been run against the existing collection.
SPARSE_SEARCH_ENABLED=false

# Name of the sparse vector field stored in Qdrant
SPARSE_VECTOR_NAME=bm25

# RRF constant used when fusing dense + sparse result lists (client-side).
# Applies when HYBRID_FUSION_METHOD=rrf (and to the detail_filter_score fallback).
RRF_K=60

# Hybrid score fusion weights. In hybrid mode the dense (cosine) and sparse (BM25)
# scores are each min-max normalized to [0,1] across the candidate pool, then
# combined as: HYBRID_DENSE_WEIGHT*dense + HYBRID_SPARSE_WEIGHT*sparse. This yields a
# calibrated 0-1 score comparable to filter_score (raw RRF scores are ~0-0.1 and would
# never clear a cosine-scale threshold). Should sum to 1.0. Used only when
# HYBRID_FUSION_METHOD=weighted.
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3

# How the dense and sparse modalities are fused into the final ranking score:
#   weighted = HYBRID_DENSE_WEIGHT*minmax(dense) + HYBRID_SPARSE_WEIGHT*minmax(sparse)
#   rrf      = Reciprocal Rank Fusion of the combined dense list (ranked by the
#              weighted multi-field cosine sum) vs the sparse list, using RRF_K,
#              then min-max normalized to [0,1].
# The dense component stays the weighted multi-field cosine sum in both modes.
HYBRID_FUSION_METHOD=weighted

# Default for the per-request `include_scoring_debug` flag. When true, every search
# result carries the hybrid fusion breakdown (keyword_score, rrf_score, dense_rank,
# sparse_rank) so the final score can be traced to the fusion math. A request may
# override this per call. Keep false in production to keep responses lean.
INCLUDE_SCORING_DEBUG=false

# Candidate pool sizing for multi-field search. Each dense named-vector search
# (title/text/tags/summary/metadata) and the sparse BM25 search retrieves up to
# min(top_k * SEARCH_CANDIDATE_FANOUT, SEARCH_CANDIDATE_MAX) candidates; the union is
# fused/ranked. SEARCH_CANDIDATE_MAX bounds HNSW `ef` — the dominant query cost — so a
# large top_k cannot trigger a 10k-deep traversal per field; SEARCH_CANDIDATE_FANOUT
# gives small-top_k callers a re-ranking margin (retrieve more than you return).
#
# SEARCH_CANDIDATE_MAX also influences result `count`: the hybrid score is normalized
# across the candidate pool, so a larger pool lets more docs clear filter_score.
# Trade-off (query "Classroom Observation"): 500 ≈ 0.9s/count 21, 2000 ≈ 1.5s/count 55,
# 10000 ≈ 2.7s/count 151. Raise toward 10000 for fuller counts, lower toward 500 for speed.
SEARCH_CANDIDATE_FANOUT=8
SEARCH_CANDIDATE_MAX=2000

# ── Acronym Search ────────────────────────────────────────────────────────────
# Master switch for acronym search. Normal queries are the same either way.
ACRONYM_SEARCH_ENABLED=true
# Minimum stem length for prefix-matching expansion words ("institute" ~ "institutes").
ACRONYM_MIN_PREFIX_MATCH_LEN=4
# Most extra letters a document word may have over an expansion word:
# "test"~"tests" (+1) matches, "test"~"testimony" (+5) does not.
ACRONYM_PREFIX_SUFFIX_CAP=3
# Longest multi-word acronym (in words) that detection finds and upload accepts.
ACRONYM_MAX_PHRASE_WORDS=4
# Words of the query checked for acronyms (the rest is still searched, only not
# looked up), so a very long query cannot flood Redis and Postgres.
ACRONYM_MAX_QUERY_WORDS=30
# dual_query only: semantic texts per query, the query included.
ACRONYM_MAX_DENSE_VARIANTS=3
# inline (default): one text with each meaning next to its acronym ("PTM (Parent Teacher Meeting)").
# dual_query: the query and each meaning searched separately; each field keeps the higher score.
ACRONYM_SEARCH_METHOD=inline

# Redis can be used for caching based on this flag. If false, Redis is not used at all (no connection attempt, no per-lookup timeout tax).
CACHE_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ai_vector_service
# Seconds to open a connection, and the longest query in milliseconds.
POSTGRES_CONNECT_TIMEOUT=3
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=local
